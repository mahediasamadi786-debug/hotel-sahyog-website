@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap');
:root{--ink:#111d2c;--cream:#f4f0e8;--gold:#c8a66b;--muted:#8e9297;--white:#fff}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font-family:'DM Sans',sans-serif}a{color:inherit;text-decoration:none}.topbar{height:82px;padding:0 6vw;display:flex;align-items:center;justify-content:space-between;background:#101b2b;color:white;position:relative;z-index:5}.brand{display:flex;align-items:center;gap:12px;font-size:12px;letter-spacing:2px}.brand-mark{width:42px;height:42px;border:1px solid var(--gold);display:grid;place-items:center;color:var(--gold);font-family:'Playfair Display';font-size:19px;letter-spacing:0}.brand small{display:block;color:#aeb7c0;font-size:8px;letter-spacing:3px;margin-top:4px}nav{display:flex;align-items:center;gap:34px;font-size:12px;color:#d8dce1}nav a:hover{color:var(--gold)}.nav-cta{padding:13px 19px;border:1px solid #8f7957;color:#f2d7a7}.menu-toggle{display:none;background:none;color:white;border:0;font-size:24px}
.hero{min-height:650px;background:radial-gradient(ellipse at 78% 47%,#263c52 0,#15283c 38%,#101b2b 75%);color:white;position:relative;display:grid;grid-template-columns:42% 58%;padding:85px 6vw 75px;overflow:hidden}.hero-copy{z-index:2;padding-top:34px}.eyebrow{font-size:9px;letter-spacing:3px;color:var(--gold);font-weight:700;margin:0 0 24px}.hero h1,.section h2{font-family:'Playfair Display',serif;font-weight:500;font-size:clamp(45px,5.5vw,76px);line-height:1.06;letter-spacing:-2px;margin:0}.hero h1 em,.section h2 em{font-weight:500;color:var(--gold)}.hero-sub{color:#b7c0c9;max-width:350px;line-height:1.8;font-size:13px;margin:25px 0 30px}.hero-actions{display:flex;align-items:center;gap:26px}.button{display:inline-flex;align-items:center;justify-content:space-between;gap:28px;padding:16px 20px;font:600 11px 'DM Sans';border:0;cursor:pointer}.primary{background:var(--gold);color:#172334}.button span{font-size:17px}.text-link{font-size:11px;color:#d5dce2}.hero-note{font-size:10px;color:#9ba9b6;margin-top:70px;letter-spacing:1px}.live-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:#9dc4a7;margin-right:9px}.scene-wrap{position:relative;min-height:430px}.scene-label{position:absolute;top:0;left:5%;right:3%;display:flex;justify-content:space-between;font-size:8px;letter-spacing:2px;color:#8e9cab;z-index:2}#hotel3d{height:420px;width:100%;cursor:grab;position:relative;z-index:1}#hotel3d:active{cursor:grabbing}.scene-hint{position:absolute;bottom:0;right:8%;font-size:9px;color:#8293a3;letter-spacing:1px}.scene-glow{position:absolute;width:350px;height:160px;bottom:20px;left:25%;background:#b38c55;filter:blur(90px);opacity:.17}.hero-bottom{position:absolute;bottom:25px;left:6vw;right:6vw;display:flex;justify-content:space-between;font-size:8px;letter-spacing:2px;color:#718091}.section{padding:100px 8vw}.intro{display:grid;grid-template-columns:1fr 1fr;align-items:end;gap:8vw}.dark{color:#9b7844}.section h2{font-size:clamp(39px,4.5vw,60px)}.section h2 em{color:#a7834e}.intro-text,.section-heading>p{font-size:13px;line-height:1.9;color:#72777c;max-width:400px}.section-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:38px}.room-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:22px}.room-card{position:relative;height:390px;overflow:hidden;background:#ddd}.room-card.large{height:470px}.room-card img,.dining-image img,.gallery-grid img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .7s}.room-card:hover img,.gallery-grid img:hover{transform:scale(1.035)}.room-caption{position:absolute;bottom:0;left:0;right:0;padding:55px 27px 24px;color:white;background:linear-gradient(transparent,rgba(5,13,22,.8))}.room-caption span{font-size:8px;letter-spacing:2px;color:#e2c38f}.room-caption h3{font:26px 'Playfair Display';margin:8px 0 0}.dining{background:#142338;color:white;display:grid;grid-template-columns:1fr 1fr;gap:8vw;align-items:center}.dining-image{height:430px;overflow:hidden}.dining-copy p:not(.eyebrow){color:#b9c2cc;font-size:13px;line-height:1.9;max-width:390px;margin:24px 0 30px}.light{background:#f2eee6;color:#142338}.gallery-grid{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:14px;height:310px}.gallery-grid img{min-width:0}.booking{background:#e9e3d8;display:grid;grid-template-columns:1fr 1fr;gap:10vw}.booking-copy>p:not(.eyebrow){color:#74777a;font-size:13px;line-height:1.9;max-width:360px;margin:25px 0 45px}.contact-line{border-top:1px solid #d0c7b9;padding:16px 0;display:flex;flex-direction:column;gap:7px}.contact-line span{font-size:8px;letter-spacing:2px;color:#987849}.contact-line b{font-size:12px;font-weight:500}.booking-form{background:#fff;padding:36px 38px;box-shadow:0 18px 60px #17233412}.form-title{font:27px 'Playfair Display';margin-bottom:25px}.form-title span{float:right;color:var(--gold)}label{display:block;font-size:10px;font-weight:600;color:#5b626a;margin:0 0 17px}input,select,textarea{display:block;width:100%;margin-top:8px;border:1px solid #e2e0dc;background:#faf9f7;padding:13px 12px;font:12px 'DM Sans';color:#1b2736;border-radius:0}input:focus,select:focus,textarea:focus{outline:1px solid #b28c54}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}.submit{width:100%;margin-top:4px}.booking-form small{display:block;color:#96999c;font-size:9px;line-height:1.6;margin-top:13px}.form-status{font-size:11px;min-height:16px;color:#3f7650}footer{background:#101b2b;color:#c1c8d0;padding:30px 6vw;display:flex;align-items:center;justify-content:space-between;font-size:10px}footer>p{color:#8d9aa6}.footer-brand{color:white}footer>a:last-child{color:var(--gold)}
@media(max-width:760px){.topbar{height:70px;padding:0 5vw}.menu-toggle{display:block}nav{display:none;position:absolute;top:70px;left:0;right:0;background:#101b2b;padding:20px 6vw 28px;flex-direction:column;align-items:flex-start;gap:20px}nav.open{display:flex}.hero{padding:58px 6vw 65px;display:flex;flex-direction:column;min-height:auto}.hero-copy{padding:0}.hero h1{font-size:56px}.hero-note{margin-top:35px}.scene-wrap{min-height:330px;margin-top:40px}#hotel3d{height:310px}.hero-bottom{font-size:7px}.section{padding:70px 6vw}.intro,.dining,.booking{grid-template-columns:1fr;gap:35px}.intro{align-items:start}.section-heading{display:block}.section-heading>p{margin-top:18px}.room-grid{grid-template-columns:1fr}.room-card,.room-card.large{height:340px}.dining-image{height:300px}.gallery-grid{height:auto;grid-template-columns:1fr 1fr}.gallery-grid img{height:180px}.gallery-grid img:first-child{grid-column:span 2;height:220px}.booking-form{padding:27px 20px}footer{gap:18px;flex-wrap:wrap}footer>p{order:3;width:100%;margin:0}}

.amenity-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-top:35px}
.amenity{background:#fff;padding:24px 18px;min-height:115px;display:flex;flex-direction:column;justify-content:space-between;border:1px solid #e8e2d8}
.amenity span{font-size:9px;color:#a7834e;letter-spacing:2px}
.amenity b{font-size:12px;font-weight:600}
.nearby-note{margin-top:28px;padding:30px;background:#e9e3d8;display:flex;align-items:center;justify-content:space-between;gap:25px}
.nearby-note h3{font:29px 'Playfair Display';margin:0 0 10px}
.nearby-note p:not(.eyebrow){max-width:600px;font-size:12px;line-height:1.8;color:#72777c;margin:0}
@media(max-width:760px){.amenity-grid{grid-template-columns:1fr 1fr}.nearby-note{align-items:flex-start;flex-direction:column}.nearby-note .button{width:100%}}
