const menuToggle = document.getElementById("menuToggle");
const nav = document.getElementById("nav");
menuToggle.addEventListener("click", () => nav.classList.toggle("open"));
nav.querySelectorAll("a").forEach(a => a.addEventListener("click", () => nav.classList.remove("open")));
document.getElementById("year").textContent = new Date().getFullYear();

const checkin = document.querySelector('[name="checkin"]');
const checkout = document.querySelector('[name="checkout"]');
const today = new Date().toISOString().slice(0,10);
checkin.min = today; checkout.min = today;
checkin.addEventListener("change", () => { checkout.min = checkin.value; if (checkout.value && checkout.value <= checkin.value) checkout.value = ""; });

document.getElementById("bookingForm").addEventListener("submit", async (e) => {
  e.preventDefault();
  const form = e.currentTarget;
  const status = document.getElementById("formStatus");
  const data = Object.fromEntries(new FormData(form).entries());
  if (data.checkout <= data.checkin) { status.textContent = "Check-out date must be after check-in."; return; }
  status.textContent = "Sending your enquiry…";
  try {
    const response = await fetch("/api/bookings", { method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify(data) });
    const result = await response.json();
    if (!response.ok) throw new Error(result.message || "Please try again.");
    status.textContent = "Thank you! Your enquiry has been received. The hotel will contact you.";
    form.reset();
  } catch (err) { status.textContent = err.message || "Could not send. Please try again."; }
});

function create3DHotel() {
  const mount = document.getElementById("hotel3d");
  if (!window.THREE) {
    mount.innerHTML = '<div class="fallback-building">HOTEL<br><b>SAHAYOG</b></div>';
    return;
  }
  const scene = new THREE.Scene();
  scene.background = null;
  const camera = new THREE.PerspectiveCamera(35, mount.clientWidth / mount.clientHeight, .1, 100);
  camera.position.set(8, 6, 11);
  const renderer = new THREE.WebGLRenderer({antialias:true, alpha:true});
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
  renderer.setSize(mount.clientWidth, mount.clientHeight);
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  mount.appendChild(renderer.domElement);
  scene.add(new THREE.AmbientLight(0xffffff, 1.65));
  const key = new THREE.DirectionalLight(0xffdfb0, 2.4); key.position.set(6,10,7); scene.add(key);
  const fill = new THREE.PointLight(0x6a9ed6, 22, 30); fill.position.set(-6,4,-4); scene.add(fill);
  const hotel = new THREE.Group(); scene.add(hotel);
  const mat = (color, metalness=0, roughness=.7) => new THREE.MeshStandardMaterial({color, metalness, roughness});
  const stone = mat(0xb8b4ad), dark = mat(0x26384a,.35,.35), glass = new THREE.MeshStandardMaterial({color:0x5d91aa,metalness:.55,roughness:.18}), gold=mat(0xc6a36b,.55,.35), white=mat(0xe6e0d5);
  function block(w,h,d,x,y,z,m){const mesh=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),m);mesh.position.set(x,y,z);mesh.castShadow=true;mesh.receiveShadow=true;hotel.add(mesh);return mesh;}
  // Main hotel mass and upper glass band
  block(7,2.4,3.6,0,1.2,0,stone);
  block(7.1,.95,3.68,0,2.86,0,glass);
  block(7.25,.16,3.82,0,2.35,0,gold);
  block(2.0,3.6,3.9,-2.65,1.8,.08,dark);
  block(2.0,.16,4.0,-2.65,3.62,.08,gold);
  // Entry canopy and columns
  block(7.8,.22,1.25,0,.9,2.15,dark);
  for(let x=-3.2;x<=3.21;x+=1.6) block(.12,1.55,.12,x,.1,2.65,gold);
  // Window grid on front facade
  for(let x=-2.85;x<=2.86;x+=.72) for(let y=1.35;y<=2.0;y+=.48) block(.48,.27,.035,x,y,1.84,glass);
  // Side wing, roof detail, sign panel
  block(2.3,2.8,3.5,3.55,1.4,-.1,white);
  block(1.4,.45,.12,-2.65,3.1,2.09,gold);
  // Ground plinth
  block(9.5,.18,5.8,0,-.12,0,mat(0x58606a));
  // Stylized trees and path
  for(let i=0;i<5;i++){let x=-5+i*2.5;const trunk=new THREE.Mesh(new THREE.CylinderGeometry(.07,.1,.65,8),gold);trunk.position.set(x,.3,-2.8);hotel.add(trunk);const crown=new THREE.Mesh(new THREE.IcosahedronGeometry(.42,1),mat(0x547b68));crown.position.set(x,.85,-2.8);hotel.add(crown);}
  const floor=new THREE.GridHelper(24,24,0x8b9aaa,0x42566b);floor.position.y=-.23;scene.add(floor);
  const orbit={x:0,y:0,down:false,px:0,py:0};
  renderer.domElement.addEventListener("pointerdown",e=>{orbit.down=true;orbit.px=e.clientX;orbit.py=e.clientY;renderer.domElement.setPointerCapture(e.pointerId);});
  renderer.domElement.addEventListener("pointerup",()=>orbit.down=false);
  renderer.domElement.addEventListener("pointermove",e=>{if(!orbit.down)return;orbit.y+=(e.clientX-orbit.px)*.008;orbit.x+=(e.clientY-orbit.py)*.004;orbit.x=Math.max(-.25,Math.min(.45,orbit.x));orbit.px=e.clientX;orbit.py=e.clientY;});
  renderer.domElement.addEventListener("wheel",e=>{camera.position.multiplyScalar(e.deltaY>0?1.06:.94);camera.position.clampLength(8,24);},{passive:true});
  let auto=0;
  function animate(){requestAnimationFrame(animate);auto+=.002;hotel.rotation.y=orbit.y+(orbit.down?0:Math.sin(auto)*.08);hotel.rotation.x=orbit.x;renderer.render(scene,camera);}
  animate();
  new ResizeObserver(()=>{camera.aspect=mount.clientWidth/mount.clientHeight;camera.updateProjectionMatrix();renderer.setSize(mount.clientWidth,mount.clientHeight);}).observe(mount);
}
create3DHotel();

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Hotel Sahayog | Comfortable Stay & Dining</title>
  <meta name="description" content="Discover Hotel Sahayog. Explore comfortable rooms, dining and hotel facilities, and send a booking enquiry.">
  <meta name="robots" content="index,follow">
  <meta name="theme-color" content="#101b2b">
  <link rel="canonical" href="https://YOUR-DOMAIN.example/">
  <link rel="stylesheet" href="/styles.css">
  <script type="application/ld+json">
  {
    "@context":"https://schema.org",
    "@type":"Hotel",
    "name":"Hotel Sahayog",
    "description":"Comfortable hotel stay and dining.",
    "url":"https://YOUR-DOMAIN.example/",
    "image":["https://YOUR-DOMAIN.example/images/hotel-front-1.jpg"],
    "telephone":"+917046903440",
    "address":{"@type":"PostalAddress","streetAddress":"Vansda-Waghai Road, Mahuvas","addressLocality":"Vansda, Navsari","postalCode":"396580","addressRegion":"Gujarat","addressCountry":"IN"}
  }
  </script>
</head>
<body>
<header class="topbar">
  <a class="brand" href="#home"><span class="brand-mark">HS</span><span>HOTEL <b>SAHAYOG</b><small>STAY • DINE • RELAX</small></span></a>
  <button class="menu-toggle" aria-label="Open navigation" id="menuToggle">☰</button>
  <nav id="nav"><a href="#home">Home</a><a href="#rooms">Rooms</a><a href="#dining">Dining</a><a href="#facilities">Facilities</a><a href="#gallery">Gallery</a><a class="nav-cta" href="#booking">Book a stay</a></nav>
</header>

<main>
<section class="hero" id="home">
  <div class="hero-copy">
    <p class="eyebrow">WELCOME TO HOTEL SAHAYOG</p>
    <h1>A stay that feels<br><em>just right.</em></h1>
    <p class="hero-sub">A comfortable place to pause, recharge and enjoy good hospitality.</p>
    <div class="hero-actions"><a class="button primary" href="#booking">Enquire now <span>↗</span></a><a class="text-link" href="#gallery">Explore the hotel ↓</a></div>
    <div class="hero-note"><span class="live-dot"></span> Your comfort is our priority</div>
  </div>
  <div class="scene-wrap">
    <div class="scene-label"><span>01 / THE HOTEL</span><span>INTERACTIVE 3D VIEW</span></div>
    <div id="hotel3d" aria-label="Interactive 3D-inspired hotel building illustration"></div>
    <div class="scene-hint">Drag to rotate · Scroll to zoom</div>
    <div class="scene-glow"></div>
  </div>
  <div class="hero-bottom"><span>HOSPITALITY, MADE PERSONAL</span><span>SCROLL TO DISCOVER ↓</span></div>
</section>

<section class="intro section">
  <div><p class="eyebrow dark">THE SAHAYOG EXPERIENCE</p><h2>Simple comforts.<br><em>Memorable moments.</em></h2></div>
  <p class="intro-text">Whether you're visiting for a short break or a longer stay, Hotel Sahayog welcomes you with inviting spaces and thoughtful essentials.</p>
</section>

<section class="rooms section" id="rooms">
  <div class="section-heading"><div><p class="eyebrow dark">REST EASY</p><h2>Rooms made for <em>you.</em></h2></div><p>Take a look at the spaces waiting for you.</p></div>
  <div class="room-grid">
    <article class="room-card large"><img src="/images/bedroom.jpg" alt="Hotel Sahayog bedroom with double bed and purple accents"><div class="room-caption"><span>01 — ROOM VIEW</span><h3>Comfortable rooms</h3></div></article>
    <article class="room-card"><img src="/images/room-desk.jpg" alt="Hotel room desk, television and seating"><div class="room-caption"><span>02 — IN-ROOM SPACE</span><h3>Relax and unwind</h3></div></article>
  </div>
</section>

<section class="dining section" id="dining">
  <div class="dining-image"><img src="/images/restaurant.jpg" alt="Hotel Sahayog dining hall with tables and decorative ceiling"></div>
  <div class="dining-copy"><p class="eyebrow">A PLACE TO GATHER</p><h2>Good food.<br><em>Good company.</em></h2><p>Discover the dining space at Hotel Sahayog. Contact the hotel for current restaurant timings, menu and group arrangements.</p><a class="button light" href="#booking">Ask about dining <span>↗</span></a></div>
</section>

<section class="amenities section" id="facilities">
  <div class="section-heading"><div><p class="eyebrow dark">THOUGHTFUL ESSENTIALS</p><h2>Made for an easy <em>stay.</em></h2></div><p>Useful comforts for road trips, family visits and getaways around Saputara.</p></div>
  <div class="amenity-grid">
    <div class="amenity"><span>01</span><b>Air-conditioned rooms</b></div>
    <div class="amenity"><span>02</span><b>On-site restaurant</b></div>
    <div class="amenity"><span>03</span><b>Free Wi-Fi</b></div>
    <div class="amenity"><span>04</span><b>Parking</b></div>
    <div class="amenity"><span>05</span><b>Daily housekeeping</b></div>
  </div>
  <div class="nearby-note"><div><p class="eyebrow dark">EXPLORE THE AREA</p><h3>On the way to Saputara.</h3><p>Hotel Sahayog is located on Vansda-Waghai Road in Mahuvas, a convenient roadside stop for travellers exploring the region. Vansda National Park is approximately a 10-minute drive away.</p></div><a class="button primary" href="https://www.google.com/maps/search/?api=1&query=Hotel+Sahyog+Mahuvas+Vansda+Navsari+Gujarat" target="_blank" rel="noopener">Get directions <span>↗</span></a></div>
</section>

<section class="gallery section" id="gallery">
  <div class="section-heading"><div><p class="eyebrow dark">A CLOSER LOOK</p><h2>Hotel <em>gallery.</em></h2></div><p>Photos of Hotel Sahayog, shared by the hotel.</p></div>
  <div class="gallery-grid">
    <img src="/images/hotel-front-1.jpg" alt="Exterior view of Hotel Sahayog">
    <img src="/images/hotel-front-2.jpg" alt="Another exterior view of Hotel Sahayog">
    <img src="/images/bedroom.jpg" alt="Guest bedroom">
  </div>
</section>

<section class="booking section" id="booking">
  <div class="booking-copy"><p class="eyebrow">PLAN YOUR VISIT</p><h2>Let's make your<br><em>stay happen.</em></h2><p>Send a booking enquiry. The hotel team can follow up to confirm availability and rates.</p><div class="contact-line"><span>PHONE / WHATSAPP</span><b><a href="tel:+917046903440">+91 70469 03440</a> · <a href="https://wa.me/917046903440" target="_blank" rel="noopener">WhatsApp us ↗</a></b></div><div class="contact-line"><span>LOCATION</span><b>Vansda-Waghai Road, Mahuvas, Vansda, Navsari, Gujarat 396580</b></div><div class="contact-line"><span>CHECK-IN / CHECK-OUT</span><b>12:00 PM / 11:00 AM</b></div></div>
  <form id="bookingForm" class="booking-form">
    <div class="form-title">Booking enquiry <span>✳</span></div>
    <label>Your name<input name="name" required placeholder="Full name" autocomplete="name"></label>
    <label>Phone number<input name="phone" required placeholder="+91 ..." autocomplete="tel"></label>
    <div class="form-row"><label>Check-in<input type="date" name="checkin" required></label><label>Check-out<input type="date" name="checkout" required></label></div>
    <div class="form-row"><label>Guests<select name="guests"><option>1</option><option selected>2</option><option>3</option><option>4</option><option>5</option><option>6</option></select></label><label>Room type<select name="room"><option>Not specified</option><option>Standard room</option><option>Deluxe room</option><option>Family room</option></select></label></div>
    <label>Additional note<textarea name="note" rows="3" placeholder="Any special request?"></textarea></label>
    <button class="button primary submit" type="submit">Send enquiry <span>↗</span></button>
    <p class="form-status" id="formStatus" role="status"></p>
    <small>Your enquiry is sent to the website server. A submission is not a confirmed reservation.</small>
  </form>
</section>
</main>
<footer><a class="brand footer-brand" href="#home"><span class="brand-mark">HS</span><span>HOTEL <b>SAHAYOG</b><small>STAY • DINE • RELAX</small></span></a><p>© <span id="year"></span> Hotel Sahayog. All rights reserved.</p><a href="#home">Back to top ↑</a></footer>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r152/three.min.js"></script>
<script src="/app.js"></script>
</body>
</html>
